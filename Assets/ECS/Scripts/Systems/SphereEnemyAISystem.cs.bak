using Unity.Collections;
using Unity.Entities;
using Unity.Mathematics;
using UnityEngine;
using UnityEngine.AI;

/// <summary>
/// ECS System for sphere enemy AI behavior
/// Handles state machine logic for sphere enemies
/// </summary>
public partial struct SphereEnemyAISystem : ISystem
{
    public void OnCreate(ref SystemState state)
    {
        // Only run when sphere enemies exist
        state.RequireForUpdate<SphereEnemyData>();
    }

    public void OnUpdate(ref SystemState state)
    {
        // Find player and check if alive
        var playerQuery = SystemAPI.QueryBuilder()
            .WithAll<PlayerData, HealthData, Transform>()
            .Build();

        if (playerQuery.IsEmpty)
        {
            return;
        }

        var playerEntities = playerQuery.ToEntityArray(state.WorldUpdateAllocator);
        if (playerEntities.Length == 0)
        {
            return;
        }

        var playerEntity = playerEntities[0];
        var playerHealth = state.EntityManager.GetComponentData<HealthData>(playerEntity);
        
        if (!state.EntityManager.HasComponent<Transform>(playerEntity))
        {
            return;
        }
            
        var playerTransform = state.EntityManager.GetComponentObject<Transform>(playerEntity);
        if (playerTransform == null)
        {
            return;
        }

        var playerPosition = (float3)playerTransform.position;
        var playerAlive = playerHealth.Value > 0;
        var deltaTime = SystemAPI.Time.DeltaTime;
        var currentTime = (float)SystemAPI.Time.ElapsedTime;

        // Query for all living sphere enemies
        var sphereEnemyQuery = SystemAPI.QueryBuilder()
            .WithAll<SphereEnemyData, SphereEnemyPatrolData, HealthData>()
            .WithNone<DeadData>()
            .Build();

        var sphereEnemyEntities = sphereEnemyQuery.ToEntityArray(state.WorldUpdateAllocator);

        // Process each sphere enemy
        foreach (var entity in sphereEnemyEntities)
        {
            var sphereData = state.EntityManager.GetComponentData<SphereEnemyData>(entity);
            var patrolData = state.EntityManager.GetComponentData<SphereEnemyPatrolData>(entity);
            var enemyHealth = state.EntityManager.GetComponentData<HealthData>(entity);
            
            // Skip if enemy is dead
            if (enemyHealth.Value <= 0)
            {
                continue;
            }

            // Get enemy transform
            if (!state.EntityManager.HasComponent<Transform>(entity))
            {
                continue;
            }

            var enemyTransform = state.EntityManager.GetComponentObject<Transform>(entity);
            if (enemyTransform == null)
            {
                continue;
            }

            var enemyPosition = (float3)enemyTransform.position;
            var distanceToPlayer = math.distance(enemyPosition, playerPosition);
            var previousMode = sphereData.CurrentMode;

            // AI State Machine
            switch (sphereData.CurrentMode)
            {
                case SphereEnemyData.AIMode.Idle:
                    if (distanceToPlayer <= sphereData.DetectionRange)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Chase;
                    }
                    else if (currentTime - sphereData.LastModeChangeTime > 2f)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Patrol;
                    }
                    break;
                    
                case SphereEnemyData.AIMode.Patrol:
                    if (distanceToPlayer <= sphereData.DetectionRange)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Chase;
                    }
                    else
                    {
                        // Handle patrol movement
                        var navAgent = state.EntityManager.GetComponentObject<NavMeshAgent>(entity);
                        if (navAgent != null && navAgent.enabled && navAgent.isOnNavMesh)
                        {
                            if (!navAgent.pathPending && navAgent.remainingDistance < 0.5f)
                            {
                                patrolData = SetNewPatrolTarget(patrolData, sphereData.PatrolRadius, currentTime);
                            }
                            navAgent.SetDestination(patrolData.PatrolTarget);
                        }
                        else
                        {
                            // Fallback movement without NavMesh
                            MoveTowardsTarget(enemyTransform, patrolData.PatrolTarget, sphereData.MoveSpeed, deltaTime);
                            if (math.distance(enemyPosition, patrolData.PatrolTarget) < 1f)
                            {
                                patrolData = SetNewPatrolTarget(patrolData, sphereData.PatrolRadius, currentTime);
                            }
                        }
                    }
                    break;
                    
                case SphereEnemyData.AIMode.Chase:
                    if (distanceToPlayer > sphereData.DetectionRange * 1.5f)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Patrol;
                    }
                    else if (distanceToPlayer <= sphereData.AttackRange)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Attack;
                    }
                    else if (playerAlive)
                    {
                        // Handle chase movement
                        var navAgent = state.EntityManager.GetComponentObject<NavMeshAgent>(entity);
                        if (navAgent != null && navAgent.enabled && navAgent.isOnNavMesh)
                        {
                            navAgent.SetDestination(playerPosition);
                        }
                        else
                        {
                            // Fallback movement without NavMesh
                            MoveTowardsTarget(enemyTransform, playerPosition, sphereData.MoveSpeed, deltaTime);
                        }
                    }
                    else
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Idle;
                    }
                    break;
                    
                case SphereEnemyData.AIMode.Attack:
                    if (distanceToPlayer > sphereData.AttackRange * 1.2f)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Chase;
                    }
                    else
                    {
                        // Stop moving when attacking
                        var navAgent = state.EntityManager.GetComponentObject<NavMeshAgent>(entity);
                        if (navAgent != null && navAgent.enabled)
                        {
                            navAgent.SetDestination(enemyTransform.position);
                        }
                        
                        // Simple attack logic - could be expanded
                        if (currentTime - sphereData.LastModeChangeTime > 1f)
                        {
                            sphereData.CurrentMode = SphereEnemyData.AIMode.Retreat;
                        }
                    }
                    break;
                    
                case SphereEnemyData.AIMode.Retreat:
                    if (distanceToPlayer > sphereData.DetectionRange)
                    {
                        sphereData.CurrentMode = SphereEnemyData.AIMode.Patrol;
                    }
                    else
                    {
                        // Move away from player
                        var retreatDirection = math.normalize(enemyPosition - playerPosition);
                        var retreatTarget = enemyPosition + retreatDirection * 5f;
                        
                        var navAgent = state.EntityManager.GetComponentObject<NavMeshAgent>(entity);
                        if (navAgent != null && navAgent.enabled && navAgent.isOnNavMesh)
                        {
                            navAgent.SetDestination(retreatTarget);
                        }
                        else
                        {
                            // Fallback movement without NavMesh
                            MoveTowardsTarget(enemyTransform, retreatTarget, sphereData.MoveSpeed, deltaTime);
                        }
                        
                        if (currentTime - sphereData.LastModeChangeTime > 3f)
                        {
                            sphereData.CurrentMode = SphereEnemyData.AIMode.Patrol;
                        }
                    }
                    break;
            }

            // Update mode change time if mode changed
            if (previousMode != sphereData.CurrentMode)
            {
                sphereData.LastModeChangeTime = currentTime;
            }

            // Write updated data back to entity
            state.EntityManager.SetComponentData(entity, sphereData);
            state.EntityManager.SetComponentData(entity, patrolData);
        }
    }

    private static SphereEnemyPatrolData SetNewPatrolTarget(SphereEnemyPatrolData patrolData, float patrolRadius, float currentTime)
    {
        var random = Unity.Mathematics.Random.CreateFromIndex((uint)(currentTime * 1000));
        var randomDirection = random.NextFloat3(-1f, 1f);
        randomDirection.y = 0; // Keep on ground level
        randomDirection = math.normalize(randomDirection) * random.NextFloat(0.5f, patrolRadius);
        
        var newTarget = patrolData.StartPosition + randomDirection;
        newTarget.y = patrolData.StartPosition.y; // Keep same height
        
        patrolData.PatrolTarget = newTarget;
        return patrolData;
    }

    private static void MoveTowardsTarget(Transform transform, float3 target, float moveSpeed, float deltaTime)
    {
        if (transform == null)
            return;

        var direction = math.normalize(target - (float3)transform.position);
        direction.y = 0; // Keep on ground level

        if (math.length(direction) > 0.1f)
        {
            // Rotate towards target
            var targetRotation = quaternion.LookRotation(direction, math.up());
            transform.rotation = math.slerp(transform.rotation, targetRotation, 5f * deltaTime);

            // Move forward
            transform.Translate(Vector3.forward * moveSpeed * deltaTime);
        }
    }
}